45,"comment":"36x36 of 8m length","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220508_132636_5525028049153578436.jpg","JPEG_20220508_132647_3975847598332383783.jpg","JPEG_20220508_132714_3822509556641852001.jpg"]},{"fid":41,"lon":85.31949123537105,"lat":27.61781942229914,"comment":"Towards dhapakhel","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220508_143029_1607502708552982231.jpg"]},{"fid":42,"lon":85.31926732,"lat":27.61972929,"comment":"Sewage line mixed","cat":"Contamination","icon":"\ud83d\udd34","photos":["JPEG_20220508_143934_3409478229074631111.jpg","JPEG_20220508_143946_8103350722555474283.jpg"]},{"fid":43,"lon":85.31915225,"lat":27.62020722,"comment":"sewage line","cat":"Contamination","icon":"\ud83d\udd34","photos":["JPEG_20220508_144142_6362775032725002452.jpg"]},{"fid":44,"lon":85.31915971,"lat":27.62256072,"comment":"section where canal is seperated from road","cat":"Encroachment","icon":"\u26ab","photos":["JPEG_20220508_145635_7947955900981669806.jpg","JPEG_20220508_145700_3509890459380510044.jpg"]},{"fid":45,"lon":85.31924794,"lat":27.62517028,"comment":"wier","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220508_151110_1737232233520838511.jpg"]},{"fid":46,"lon":85.31830402,"lat":27.62976386,"comment":"canal branching of new and old canal","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220508_153151_2588369759715846239.jpg"]},{"fid":47,"lon":85.31830752,"lat":27.6305435,"comment":"ponding outlet towards sunaguthi","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220510_081053_5753434413962082340.jpg","JPEG_20220510_081106_4114072667287813242.jpg"]},{"fid":48,"lon":85.31868177,"lat":27.63106175,"comment":"Outlet for field irrigation. 100 Ropani land. Aara ani phile.","cat":"Vulnerable Zone","icon":"\ud83d\udfe0","photos":["JPEG_20220510_081817_2333433626189944076.jpg","JPEG_20220510_081828_8604888713304304506.jpg"]},{"fid":49,"lon":85.32006803,"lat":27.63377938,"comment":"outlet point for irrigation. Laan kwo towards malikhota","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220510_083156_3369653148520118760.jpg","JPEG_20220510_083219_1524005375768141442.jpg"]},{"fid":50,"lon":85.31876275,"lat":27.63515661,"comment":"Confluence point of two canal","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220510_083646_6646738753083233732.jpg"]},{"fid":51,"lon":85.31875543,"lat":27.6352395,"comment":"actual confluence point of two canal","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220510_084101_3151721240788289595.jpg","JPEG_20220510_084111_6817208894188633599.jpg"]},{"fid":52,"lon":85.31843053,"lat":27.63693675,"comment":"used to be pond used for ponding to branch 2 canals","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220510_084719_8142188001350540934.jpg"]},{"fid":53,"lon":85.31866683,"lat":27.63465395,"comment":"Outlet for irrigation. Kalpata","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220510_090927_3591001084706072824.jpg"]},{"fid":54,"lon":85.31852919858893,"lat":27.634338816816975,"comment":"Entrance towards old aunaguthi settlement","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220510_091135_3472353221401215903.jpg"]},{"fid":55,"lon":85.31836367927265,"lat":27.633975900474294,"comment":"pukhushi. In past pond was used for ponding","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220510_091726_1677635679960418560.jpg"]},{"fid":56,"lon":85.31824519569481,"lat":27.63364849528114,"comment":"Kwe lachi pukhu. Inlet and outlet is rajkulo","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220510_092335_3194724832471014476.jpg"]},{"fid":57,"lon":85.31786070728374,"lat":27.632617761428445,"comment":"outlet dampa tah","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220510_095422_2367808194583212438.jpg"]},{"fid":58,"lon":85.31928933509704,"lat":27.644431114565208,"comment":"no manhole seen from this point","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220510_112200_2542859425653136538.jpg"]},{"fid":59,"lon":85.31845149616122,"lat":27.63681036444175,"comment":"wrong point","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220511_100445_6866020339074958448.jpg"]},{"fid":60,"lon":85.31893819234249,"lat":27.643350588794792,"comment":"Towards kusunti sanepa","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220511_100707_6724123421350398895.jpg"]},{"fid":61,"lon":85.31849661094948,"lat":27.64012510402834,"comment":"another canal towards sanepa bagdol kusunti according to local of nakhipot","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220511_101254_4606452845996356679.jpg"]},{"fid":62,"lon":85.32147178,"lat":27.65215467,"comment":"Irrigation canal old rajkulo not connected with rajkulo of tikabhirav as seen for now","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220511_104013_3321415943867346538.jpg","JPEG_20220511_104024_6908016097794996719.jpg","JPEG_20220511_104034_5015484365025518744.jpg"]},{"fid":63,"lon":85.32155504,"lat":27.65079625,"comment":"towards east. All water flows here. according to local. End of rajkulo","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220511_105606_4635768437635979210.jpg","JPEG_20220511_105635_6771165234580029623.jpg","JPEG_20220511_105650_4301425079344521190.jpg"]},{"fid":64,"lon":85.32429065,"lat":27.65900934,"comment":"old pond. Not present current","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220511_113527_4907610598088215806.jpg","JPEG_20220511_113545_5496928322936230590.jpg"]},{"fid":65,"lon":85.32424627,"lat":27.65897002,"comment":"Old police chauki","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220511_113651_18928448633678695.jpg","JPEG_20220511_113719_3850855342266912352.jpg"]},{"fid":66,"lon":85.32383215385626,"lat":27.664523427875228,"comment":"inlet to pond.","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220511_124239_8687468819553854907.jpg","JPEG_20220511_124307_7990545349629139810.jpg"]},{"fid":67,"lon":85.32168988,"lat":27.66530033,"comment":"Inlet nhoo pukhu","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220511_151416_4805449975930998651.jpg","JPEG_20220511_151429_3075531533728940800.jpg"]},{"fid":68,"lon":85.32619254,"lat":27.66667415,"comment":"Naricha. Hiti","cat":"Observation Point","icon":"\ud83d\udd35","photos":["JPEG_20220511_163233_2428042790335500852.jpg","JPEG_20220511_163246_1860443642218936510.jpg"]}];

// ── PHOTO CONFIGURATION ───────────────────────────────────────────────────
// After uploading photos to Cloudinary, replace the URL below:
// e.g. "https://res.cloudinary.com/YOUR_CLOUD_NAME/image/upload/rajkulo_survey/"
// Leave as "" to show placeholder cards (before photos are uploaded)
const PHOTO_BASE_URL = "photos/";  // photos copied locally by build_platform_data.py — swap to Cloudinary URL when uploaded

// ── APP LOGIC ──────────────────────────────────────────────────────────────
let map, satelliteLayer, streetLayer;
let historicLayer, labelsLayer;
let sectionLayers=[];   // [{line, section}]
let poiMarkers=[];      // [{marker, poi}]
let activeSection=null;

// Filter state — populated from checked checkboxes on init() and updated by applyFilters()
const filterState = {
  flow: new Set(['Perennial', 'Seasonal', 'Other']),
  features: new Set(['surveyed', 'pois', 'labels']),
  poiCats: new Set(['Contamination','Cross Drainage','Vulnerable Zone',
                    'Encroachment','Hume Pipe','Intake Structure','Observation Point']),
};
// Map raw flow values to the four filter buckets
function flowBucket(flow) {
  const f = (flow || '').toString().trim();
  if (!f || f === '—') return 'Other';
  if (/^perennial$/i.test(f)) return 'Perennial';
  if (/^underground$/i.test(f)) return 'Underground';
  if (/seasonal|intermittent/i.test(f)) return 'Seasonal';
  return 'Other';
}

function enterApp() {
  const splash = document.getElementById('splash');
  splash.classList.add('hiding');
  setTimeout(()=>{ splash.style.display='none'; },800);
  document.getElementById('app').classList.add('visible');
  setTimeout(initMap, 400);
}

function initMap() {
  map = L.map('map', { zoomControl:true, attributionControl:true })
    .setView([27.6197, 85.3183], 13);

  satelliteLayer = L.tileLayer(
    'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
    { attribution:'Esri World Imagery', maxZoom:19 }
  ).addTo(map);

  streetLayer = L.tileLayer(
    'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
    { attribution:'© OpenStreetMap', maxZoom:19 }
  );

  buildAllLayers();
  bindFilterEvents();
  applyFilters({fit: true});
}

function buildAllLayers() {
  // Build every renderable layer once; visibility is then driven by filter state.

  // Historic canal branches (the gpkg `Canal` layer minus टि-१, ~34 km of historic context).
  if (typeof CANAL_HISTORIC !== 'undefined') {
    const histLines = CANAL_HISTORIC.map(h => L.polyline(
      h.coords.map(c => [c[1], c[0]]),
      { color:'#F7801E', weight:3, opacity:0.95, smoothFactor:1, interactive:true }
    ).bindTooltip(`<div class="section-tooltip"><strong>Historic branch</strong>${h.id||'—'}</div>`,
                  { sticky:true, offset:[10,0] }));
    historicLayer = L.layerGroup(histLines);
  }

  // Surveyed sections — one polyline per section, kept in sectionLayers with metadata
  // so the filter logic can show/hide individually by flow bucket.
  sectionLayers = [];
  CANAL_SECTIONS.forEach(s => {
    if (!s.coords || s.coords.length < 2) return;
    const latlngs = s.coords.map(c => [c[1], c[0]]);
    const line = L.polyline(latlngs, { color: s.color, weight: 5, opacity: 0.9, smoothFactor: 1 });
    const pdfLabel = s.pdf_n != null ? `#${s.pdf_n}` : '';
    const tip = `<div class="section-tooltip">
      <strong>${pdfLabel} ${s.tole && s.tole !== '—' ? s.tole : ''}</strong>
      ${s.condition} · ${s.flow || '—'}<br>
      ${s.sec_len != null ? s.sec_len + ' m  ·  ' : ''}WQ ${s.wq || '—'}
      ${s.mergin_fid != null ? '<br><span style="opacity:0.6;font-family:DM Mono,monospace;font-size:0.7em">Mergin fid #'+s.mergin_fid+'</span>' : ''}
    </div>`;
    line.bindTooltip(tip, { sticky:true, offset:[10,0] });
    line.on('click', () => showSectionDetail(s));
    line.on('mouseover', function(){ this.setStyle({weight: 8, opacity: 1}); });
    line.on('mouseout',  function(){ if(activeSection !== s) this.setStyle({weight: 5, opacity: 0.9}); });
    sectionLayers.push({ line, section: s, bucket: flowBucket(s.flow) });
  });

  // POIs — categorical icons, kept with metadata for category filtering.
  poiMarkers = [];
  const poiColors = {
    'Contamination':'#c0392b','Cross Drainage':'#2a6b8a',
    'Vulnerable Zone':'#d4721a','Encroachment':'#333333',
    'Hume Pipe':'#7c4a1e','Intake Structure':'#1D9E75',
    'Observation Point':'#2a6b8a'
  };
  CANAL_POIS.forEach(poi => {
    const col = poiColors[poi.cat] || '#2a6b8a';
    const icon = L.divIcon({
      html: `<div style="width:28px;height:28px;background:${col};border-radius:50%;border:2px solid white;display:flex;align-items:center;justify-content:center;font-size:12px;box-shadow:0 2px 6px rgba(0,0,0,0.3)">${poi.icon}</div>`,
      className:'', iconSize:[28,28], iconAnchor:[14,14]
    });
    const marker = L.marker([poi.lat, poi.lon], {icon});
    marker.bindTooltip(`<strong>${poi.cat} · #${poi.fid}</strong><br>${poi.comment||''}`, {offset:[10,0]});
    marker.on('click', () => showPOIDetail(poi));
    poiMarkers.push({ marker, poi });
  });

  drawLabels();   // settlement labels stay simple
}

function bindFilterEvents() {
  const handler = () => {
    // Pull current state from the DOM
    filterState.flow     = new Set(Array.from(document.querySelectorAll('.flt-flow:checked')).map(e => e.value));
    filterState.features = new Set(Array.from(document.querySelectorAll('.flt-feature:checked')).map(e => e.value));
    filterState.poiCats  = new Set(Array.from(document.querySelectorAll('.flt-poi:checked')).map(e => e.value));
    applyFilters();
  };
  document.querySelectorAll('.flt-flow, .flt-feature, .flt-poi').forEach(el => {
    el.addEventListener('change', handler);
  });
}

function applyFilters({fit=false} = {}) {
  // SURVEYED SECTIONS
  let shownSec = 0;
  sectionLayers.forEach(({line, section, bucket}) => {
    const show = filterState.features.has('surveyed') && filterState.flow.has(bucket);
    if (show) { line.addTo(map); shownSec++; }
    else      { map.removeLayer(line); }
  });
  // HISTORIC BRANCHES
  if (historicLayer) {
    filterState.features.has('historic') ? historicLayer.addTo(map) : map.removeLayer(historicLayer);
  }
  // POIs (also filtered by category)
  let shownPoi = 0;
  if (filterState.features.has('pois')) {
    poiMarkers.forEach(({marker, poi}) => {
      if (filterState.poiCats.has(poi.cat)) { marker.addTo(map); shownPoi++; }
      else { map.removeLayer(marker); }
    });
  } else {
    poiMarkers.forEach(({marker}) => map.removeLayer(marker));
  }
  // SETTLEMENT LABELS
  if (labelsLayer) {
    filterState.features.has('labels') ? labelsLayer.addTo(map) : map.removeLayer(labelsLayer);
  }

  // Stats line
  const stats = document.getElementById('filter-stats');
  if (stats) {
    stats.textContent = `Showing ${shownSec} / ${sectionLayers.length} sections · ${shownPoi} / ${poiMarkers.length} POIs`;
  }

  if (fit) {
    // Initial load only: fit to the surveyed sections extent
    const secCoords = CANAL_SECTIONS.flatMap(s => (s.coords||[]).map(c => [c[1],c[0]]));
    if(secCoords.length) map.fitBounds(L.latLngBounds(secCoords).pad(0.05));
  }
}

function resetFilters() {
  document.querySelectorAll('.flt-flow').forEach(e => e.checked = true);
  document.querySelectorAll('.flt-feature').forEach(e => e.checked = (e.value !== 'historic'));
  document.querySelectorAll('.flt-poi').forEach(e => e.checked = true);
  bindFilterEvents();   // re-bind in case DOM order changed — safe no-op otherwise
  // Trigger one re-application
  filterState.flow     = new Set(Array.from(document.querySelectorAll('.flt-flow:checked')).map(e => e.value));
  filterState.features = new Set(Array.from(document.querySelectorAll('.flt-feature:checked')).map(e => e.value));
  filterState.poiCats  = new Set(Array.from(document.querySelectorAll('.flt-poi:checked')).map(e => e.value));
  applyFilters({fit: true});
}

function fitToVisible() {
  const bounds = L.latLngBounds([]);
  sectionLayers.forEach(({line, section, bucket}) => {
    if (filterState.features.has('surveyed') && filterState.flow.has(bucket)) {
      line.getLatLngs().forEach(ll => bounds.extend(ll));
    }
  });
  if (filterState.features.has('pois')) {
    poiMarkers.forEach(({marker, poi}) => {
      if (filterState.poiCats.has(poi.cat)) bounds.extend(marker.getLatLng());
    });
  }
  if (bounds.isValid()) map.fitBounds(bounds.pad(0.08));
}

function drawLabels() {
  const settlements = [
    {name:'Tikabhairav (Intake)', lat:27.5741, lon:85.3179},
    {name:'Chapagaon', lat:27.5900, lon:85.3150},
    {name:'Pyangaon', lat:27.6050, lon:85.3170},
    {name:'Thecho', lat:27.6200, lon:85.3190},
    {name:'Sunakothi', lat:27.6380, lon:85.3210},
    {name:'Dholahiti', lat:27.6520, lon:85.3230},
    {name:'Lagankhel (End)', lat:27.6650, lon:85.3183},
  ];
  const labels = settlements.map(s => {
    const icon = L.divIcon({
      html:`<div style="font-family:'DM Mono',monospace;font-size:10px;color:#1a1208;background:rgba(245,240,232,0.85);padding:2px 6px;border-radius:2px;white-space:nowrap;font-weight:500;box-shadow:0 1px 4px rgba(0,0,0,0.15)">${s.name}</div>`,
      className:'', iconSize:'auto'
    });
    return L.marker([s.lat, s.lon], {icon, interactive:false});
  });
  labelsLayer = L.layerGroup(labels);   // visibility controlled by applyFilters()
}

function showSectionDetail(s) {
  activeSection = s;
  const pdfRef = s.pdf_n != null ? `Section ${s.pdf_n}` : (s.tole || `Section ${s.idx+1}`);
  const title = (s.tole && s.tole !== '—') ? `${pdfRef} · ${s.tole}` : pdfRef;
  const photos = s.photos && s.photos.length
    ? s.photos.map((p,i)=> renderPhotoThumb(p, `${title} — Photo ${i+1}`)).join('')
    : `<div style="font-size:0.78rem;color:rgba(26,18,8,0.35);font-style:italic">No photos recorded for this section.</div>`;

  const dimStr = s.shape === 'Circular'
    ? `Ø ${s.diam} cm`
    : `${s.width} cm × ${s.height} cm`;

  const chainStr = (s.chainage != null) ? `${s.chainage} m` : '—';
  const elevStr = (s.zcoord != null) ? `${s.zcoord} m ASL` : '—';
  const lenStr = (s.sec_len != null) ? `${s.sec_len} m` : '—';
  const fidStr = s.mergin_fid != null ? `Mergin fid #${s.mergin_fid}` : '';

  const isPlaceholder = s.is_connector === true;
  const placeholderBanner = isPlaceholder ? `
    <div style="margin:0.5rem 0 1rem;padding:0.55rem 0.8rem;background:rgba(124,74,30,0.08);border-left:3px solid #7c4a1e;font-size:0.78rem;color:#5a3614">
      Section defined in CAD drawings but not GPS-walked in the May 2022 survey. Location is approximate (along the canal_base alignment).
    </div>` : '';

  document.getElementById('detail-content').innerHTML = `
    <div class="detail-hero">
      <div class="detail-tole">${title}${fidStr ? ` <span style="font-family:'DM Mono',monospace;font-size:0.65rem;opacity:0.55;font-weight:400;letter-spacing:0.05em">${fidStr}</span>` : ''}</div>
      <div class="detail-condition" style="background:${s.color}">${s.condition} Condition</div>
    </div>
    ${placeholderBanner}
    <div class="detail-grid">
      <div class="dg-item">
        <div class="dg-label">Chainage</div>
        <div class="dg-val">${chainStr}</div>
      </div>
      <div class="dg-item">
        <div class="dg-label">Section Length</div>
        <div class="dg-val">${lenStr}</div>
      </div>
      <div class="dg-item">
        <div class="dg-label">Elevation (Z)</div>
        <div class="dg-val">${elevStr}</div>
      </div>
      <div class="dg-item">
        <div class="dg-label">Water Quality</div>
        <div class="dg-val">
          <span class="wq-badge" style="background:${s.wq_color}">
            <span class="wq-dot"></span>${s.wq}
          </span>
        </div>
      </div>
      <div class="dg-item">
        <div class="dg-label">Flow Regime</div>
        <div class="dg-val">${s.flow}</div>
      </div>
      <div class="dg-item">
        <div class="dg-label">Silting</div>
        <div class="dg-val" style="color:${s.silting==='Present'?'#c0392b':s.silting==='Absent'?'#1D9E75':'#888'}">${s.silting}</div>
      </div>
      <div class="dg-item">
        <div class="dg-label">Lined</div>
        <div class="dg-val">${s.lined}</div>
      </div>
      <div class="dg-item">
        <div class="dg-label">Section Shape</div>
        <div class="dg-val">${s.shape}</div>
      </div>
      <div class="dg-item">
        <div class="dg-label">Dimensions</div>
        <div class="dg-val">${dimStr}</div>
      </div>
    </div>
    <div class="detail-section">
      <div class="detail-section-title">Field Notes</div>
      ${s.notes
        ? `<div class="notes-text">${s.notes}</div>`
        : `<div class="no-notes">No additional notes recorded.</div>`}
    </div>
    <div class="detail-section">
      <div class="detail-section-title">Field Photographs (${s.photos?s.photos.length:0})</div>
      <div class="photo-grid">${photos}</div>
      ${isPlaceholder ? '' : `<div style="font-size:0.68rem;color:rgba(26,18,8,0.35);margin-top:0.5rem;font-style:italic">Tap a photo to view full size.</div>`}
    </div>
  `;

  // Pan map to section midpoint
  if(s.coords && s.coords.length) {
    const mid = s.coords[Math.floor(s.coords.length/2)];
    map.panTo([mid[1], mid[0]], {animate:true, duration:0.5});
  }

  // Highlight on map (synthetic segments aren't rendered, so all entries here are surveyed)
  sectionLayers.forEach(({line, section}) => {
    line.setStyle({
      weight: section===s ? 8 : 5,
      opacity: section===s ? 1 : 0.7
    });
  });

  // Switch to detail tab
  showTab('detail', null, true);
}

function showPOIDetail(poi) {
  const photos = poi.photos && poi.photos.length
    ? poi.photos.map((p,i)=> renderPhotoThumb(p, `${poi.cat} — ${poi.comment}`)).join('')
    : `<div style="font-size:0.78rem;color:rgba(26,18,8,0.35);font-style:italic">No photos for this POI.</div>`;

  document.getElementById('detail-content').innerHTML = `
    <div class="detail-hero">
      <div class="detail-tole">${poi.icon} ${poi.cat}</div>
      <div class="detail-condition" style="background:#2a6b8a">Point of Interest #${poi.fid}</div>
    </div>
    <div class="detail-grid">
      <div class="dg-item" style="grid-column:1/-1">
        <div class="dg-label">Observation</div>
        <div class="dg-val">${poi.comment}</div>
      </div>
      <div class="dg-item">
        <div class="dg-label">Latitude</div>
        <div class="dg-val" style="font-family:'DM Mono',monospace;font-size:0.78rem">${poi.lat.toFixed(5)}°N</div>
      </div>
      <div class="dg-item">
        <div class="dg-label">Longitude</div>
        <div class="dg-val" style="font-family:'DM Mono',monospace;font-size:0.78rem">${poi.lon.toFixed(5)}°E</div>
      </div>
    </div>
    <div class="detail-section">
      <div class="detail-section-title">Field Photographs (${poi.photos?poi.photos.length:0})</div>
      <div class="photo-grid">${photos}</div>
    </div>
  `;
  map.panTo([poi.lat, poi.lon], {animate:true, duration:0.5});
  showTab('detail', null, true);
}

function showTab(name, btn, noNavUpdate) {
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('panel-'+name).classList.add('active');
  if(!noNavUpdate) {
    document.querySelectorAll('.nav-tab').forEach(t=>t.classList.remove('active'));
    if(btn) btn.classList.add('active');
    else {
      const tabs = document.querySelectorAll('.nav-tab');
      const idx = name==='map'?0:name==='detail'?1:2;
      tabs[idx].classList.add('active');
    }
  } else {
    document.querySelectorAll('.nav-tab').forEach(t=>t.classList.remove('active'));
    document.querySelectorAll('.nav-tab')[1].classList.add('active');
  }
  if(name==='map') {
    sectionLayers.forEach(({line})=>line.setStyle({weight:5, opacity:0.85}));
    activeSection=null;
  }
}


function toggleBasemap(type, btn) {
  document.querySelectorAll('.map-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  if(type==='satellite') {
    map.removeLayer(streetLayer);
    satelliteLayer.addTo(map);
  } else {
    map.removeLayer(satelliteLayer);
    streetLayer.addTo(map);
  }
}

function renderPhotoThumb(filename, caption) {
  if (PHOTO_BASE_URL) {
    const url = PHOTO_BASE_URL + filename;
    return `<div class="photo-thumb" onclick="openLightbox('${url}','${caption}')">
      <img src="${url}" alt="${caption}" loading="lazy"
           onerror="this.parentElement.innerHTML='<div class=\'photo-placeholder\'><span>📷</span><div>Photo unavailable</div></div>'"
      />
    </div>`;
  } else {
    return `<div class="photo-thumb" style="cursor:default">
      <div class="photo-placeholder">
        <span>📷</span>
        <div style="font-size:0.6rem">${filename.substring(5,22)}…</div>
        <div style="font-size:0.55rem;opacity:0.6">Upload photos to view</div>
      </div>
    </div>`;
  }
}

function openLightbox(filename, caption) {
  document.getElementById('lb-img').src = filename;
  document.getElementById('lb-caption').textContent = caption;
  document.getElementById('lightbox').classList.add('open');
}
function closeLightbox() {
  document.getElementById('lightbox').classList.remove('open');
}
document.addEventListener('keydown', e=>{ if(e.key==='Escape') closeLightbox(); });
</script>
</body>
</html>
